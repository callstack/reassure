{
  "name": "@callstack/reassure-cli",
  "version": "1.5.0",
  "description": "Performance testing companion for React and React Native",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/commonjs/index.d.ts",
  "source": "src/index.ts",
  "bin": {
    "reassure": "lib/commonjs/bin.js"
  },
  "files": [
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./bin/reassure": "./lib/commonjs/bin.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bob build",
    "clean": "del lib"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": "https://github.com/callstack/reassure",
  "author": "Maciej Jastrzębski <mdjastrzebski@gmail.com> (https://github.com/mdjastrzebski)",
  "contributors": [
    "Jakub Bujko <jakub.bujko@callstack.com> (https://github.com/Xiltyn)",
    "Tomasz Krzyżowski <tomasz.krzyzowski@callstack.com> (https://github.com/TMaszko)",
    "Michał Pierzchała <thymikee@gmail.com> (https://github.com/thymikee)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/callstack/reassure/issues"
  },
  "homepage": "https://github.com/callstack/reassure#readme",
  "dependencies": {
    "@callstack/reassure-compare": "1.5.0",
    "@callstack/reassure-logger": "1.5.0",
    "chalk": "4.1.2",
    "simple-git": "^3.36.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-flow-strip-types": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@relmify/jest-serializer-strip-ansi": "^1.0.2",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.17",
    "@types/yargs": "^17.0.35",
    "babel-jest": "^30.4.1",
    "del-cli": "^7.0.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "react-native-builder-bob": "^0.41.0",
    "typescript": "^6.0.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
