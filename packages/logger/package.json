{
  "name": "@callstack/reassure-logger",
  "version": "1.6.0",
  "description": "Logger for Reassure project",
  "keywords": [
    "android",
    "ios",
    "react-native"
  ],
  "homepage": "https://github.com/callstack/reassure#readme",
  "bugs": {
    "url": "https://github.com/callstack/reassure/issues"
  },
  "license": "MIT",
  "author": "Maciej Jastrzębski <mdjastrzebski@gmail.com> (https://github.com/mdjastrzebski)",
  "contributors": [
    "Jakub Bujko <jakub.bujko@callstack.com> (https://github.com/Xiltyn)",
    "Michał Pierzchała <thymikee@gmail.com> (https://github.com/thymikee)"
  ],
  "repository": "https://github.com/callstack/reassure",
  "source": "src/index.ts",
  "files": [
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/commonjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bob build",
    "clean": "del lib"
  },
  "dependencies": {
    "chalk": "4.1.2"
  },
  "devDependencies": {
    "del-cli": "^7.0.0",
    "react-native-builder-bob": "^0.41.0",
    "typescript": "^6.0.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
