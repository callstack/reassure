{
  "name": "@callstack/reassure-compare",
  "version": "1.5.1",
  "description": "Performance testing companion for React and React Native",
  "keywords": [
    "android",
    "ios",
    "react-native"
  ],
  "homepage": "https://github.com/callstack/reassure#readme",
  "bugs": {
    "url": "https://github.com/callstack/reassure/issues"
  },
  "license": "MIT",
  "author": "Maciej Jastrzębski <mdjastrzebski@gmail.com> (https://github.com/mdjastrzebski)",
  "contributors": [
    "Jakub Bujko <jakub.bujko@callstack.com> (https://github.com/Xiltyn)",
    "Tomasz Krzyżowski <tomasz.krzyzowski@callstack.com> (https://github.com/TMaszko)",
    "Michał Pierzchała <thymikee@gmail.com> (https://github.com/thymikee)"
  ],
  "repository": "https://github.com/callstack/reassure",
  "source": "src/index.ts",
  "files": [
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/commonjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bob build",
    "clean": "del lib",
    "test": "jest"
  },
  "dependencies": {
    "@callstack/reassure-logger": "1.5.1",
    "mathjs": "^15.2.0",
    "ts-markdown-builder": "0.6.0",
    "ts-regex-builder": "^1.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-flow-strip-types": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@relmify/jest-serializer-strip-ansi": "^1.0.2",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.17",
    "babel-jest": "^30.4.1",
    "del-cli": "^7.0.0",
    "jest": "^30.4.2",
    "react-native-builder-bob": "^0.41.0",
    "typescript": "^6.0.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
