{
  "compilerOptions": {
    "allowJs": true,
    "isolatedModules": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react",
    "lib": ["esnext"],
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "types": ["node", "jest"],
    "paths": {
      "@callstack/reassure-cli": ["./packages/cli/src/index.ts"],
      "@callstack/reassure-compare": ["./packages/compare/src/index.ts"],
      "@callstack/reassure-danger": ["./packages/danger/src/index.ts"],
      "@callstack/reassure-logger": ["./packages/logger/src/index.ts"],
      "@callstack/reassure-measure": ["./packages/measure/src/index.ts"],
      "reassure": ["./packages/reassure/src/index.ts"]
    },
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitUseStrict": false,
    "noStrictGenericChecks": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "esnext"
  },
  "exclude": ["docusaurus"]
}
